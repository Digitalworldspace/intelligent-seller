# Copy this file to .env and fill in your own keys.
# Never commit .env to GitHub.

PORT=3000

# ---------- Amazon.in (Creators API, replaced PA-API 5 on 30 April 2026) ----------
# Get these from Amazon Associates Central (affiliate-program.amazon.in) > Tools > Creators API.
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
# The credential version is shown next to your credentials (for example 3.2 or 2.2).
AMAZON_CREDENTIAL_VERSION=3.2
# Token URL for your credential version. Check the "Using cURL > Regional endpoints" page in the Creators API docs.
#   v3.2 (Login with Amazon, EU region):  https://api.amazon.co.uk/auth/o2/token
#   v2.2 (Cognito, EU region):            https://creatorsapi.auth.eu-south-2.amazoncognito.com/oauth2/token
AMAZON_TOKEN_URL=https://api.amazon.co.uk/auth/o2/token
# Your Associates tracking tag, e.g. yourname-21
AMAZON_PARTNER_TAG=

# ---------- Flipkart Affiliate ----------
# From affiliate.flipkart.com > API token.
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# ---------- Other trusted platforms (Croma, Reliance Digital, Myntra, Nykaa, Tata CLiQ, Ajio) ----------
# These are shown as search links. If you use an affiliate network that converts links
# (for example Cuelinks or EarnKaro), put its link template here. {url} is replaced by the encoded page URL.
# Example: https://linksredirect.com/?cid=YOUR_ID&source=linkkit&url={url}
AFFILIATE_LINK_TEMPLATE=

# ---------- AI seller (optional, makes the seller's message smarter) ----------
# Without this key the seller still works with built-in rules.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
